TA_DATABASE_URL=postgresql+asyncpg://teaching:local-development-only@127.0.0.1:5432/teaching
# Choose your own token, then run: uv run teaching-assistant bootstrap
TA_DEV_API_TOKEN=replace-with-your-own-local-token
TA_EVALUATOR=fake-v1
TA_CALL_TIMEOUT_SECONDS=10
TA_LEASE_SECONDS=30
TA_POLL_SECONDS=1
# A real model is opt-in per batch via evaluation_profile=jev-v1.
# Use an exact version available to your TypeSafe account, never jev-latest.
# TA_JEV_MODEL=jev-1.13.0
# TA_JEV_API_KEY=your-typesafe-api-key
# TA_JEV_ENDPOINT=https://api.typesafe.ai/v1/systemone
# TA_JEV_MAX_INPUT_CHARACTERS=20000
# For longer real requests, change both timeout and lease together:
# TA_CALL_TIMEOUT_SECONDS=30
# TA_LEASE_SECONDS=60
# Integration tests need a separate, disposable database:
# TA_TEST_DATABASE_URL=postgresql+asyncpg://teaching:local-development-only@127.0.0.1:5432/teaching_test
