TA_DATABASE_URL=postgresql+asyncpg://teaching:local-development-only@127.0.0.1:5432/teaching
# Choose your own token, then run: uv run teaching-assistant bootstrap
TA_DEV_API_TOKEN=replace-with-your-own-local-token
TA_EVALUATOR=fake-v1
TA_CALL_TIMEOUT_SECONDS=10
TA_LEASE_SECONDS=30
TA_POLL_SECONDS=1
# A real model is opt-in per batch via evaluation_profile=jev-v1.
# Use an exact version available to your TypeSafe account, never jev-latest.
# TA_JEV_MODEL=jev-1.13.0
# TA_JEV_API_KEY=your-typesafe-api-key
# TA_JEV_ENDPOINT=https://api.typesafe.ai/v1/systemone
# Optional outbound proxy for Jev HTTP calls, e.g. a local Clash mixed port.
# TA_JEV_PROXY=http://127.0.0.1:7897
# TA_JEV_MAX_INPUT_CHARACTERS=20000
# Ordinary model baseline, opt-in per batch via evaluation_profile=deepseek-v1.
# Choose a model actually available to your account; this is a name, not immutable weights.
# TA_DEEPSEEK_MODEL=deepseek-flash
# TA_DEEPSEEK_API_KEY=your-deepseek-api-key
# TA_DEEPSEEK_ENDPOINT=https://api.deepseek.com/chat/completions
# TA_DEEPSEEK_PROXY=http://127.0.0.1:7897
# Optional exact expected response model name; defaults to the requested model name.
# TA_DEEPSEEK_EXPECTED_MODEL=deepseek-flash
# User-managed experiment label, not a provider version guarantee.
# TA_DEEPSEEK_REVISION=pilot-2026-10-21
# manual: no evidence HTTP call; model: independent, paid quote extraction per criterion.
# TA_DEEPSEEK_EVIDENCE_MODE=manual
# TA_DEEPSEEK_MAX_INPUT_CHARACTERS=40000
# TA_DEEPSEEK_MAX_OUTPUT_TOKENS=2048
# Harness v5 pins output space, token estimation, and prices in each run's manifest.
# Official deepseek-flash uses the documented 2026-10-22 peak accounting ceiling.
# Other endpoints/models need explicit verified prices before max_cost_usd is accepted.
# TA_DEEPSEEK_CONTEXT_WINDOW_TOKENS=1000000
# TA_DEEPSEEK_INPUT_USD_PER_MILLION=0.3
# TA_DEEPSEEK_OUTPUT_USD_PER_MILLION=1.2
# TA_DEEPSEEK_CACHED_INPUT_USD_PER_MILLION=0.006
# TA_DEEPSEEK_PRICE_VERSION=your-verified-price-version
# TA_DEEPSEEK_PRICE_SOURCE=https://your-provider.example/pricing
# Optional registered deny-only hook snapshot; changes apply to newly created runs.
# Restore the original settings to resume runs pinned to an older configuration.
# TA_HARNESS_HOOK_ID=deny-tools
# TA_HARNESS_HOOK_CONFIG={"denied_tools":[],"block_stop":false}
# For longer real requests, change both timeout and lease together:
# TA_CALL_TIMEOUT_SECONDS=30
# TA_LEASE_SECONDS=60
# Integration tests need a separate, disposable database:
# TA_TEST_DATABASE_URL=postgresql+asyncpg://teaching:local-development-only@127.0.0.1:5432/teaching_test
